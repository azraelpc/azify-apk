<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout android:id="@+id/header" android:layout_width="match_parent" android:layout_height="56dp"
        android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="8dp">
        <ImageView android:layout_width="32dp" android:layout_height="32dp"
            android:src="@drawable/ic_azify" android:importantForAccessibility="no" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="10dp"
            android:text="@string/app_name" android:textStyle="bold" android:textSize="24sp" />
        <ImageButton android:id="@+id/folder_back" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert" app:tint="#E5E5E5" android:visibility="gone"
            android:contentDescription="@string/back_to_folder_list" android:tooltipText="@string/back_to_folder_list" />
        <ImageButton android:id="@+id/refresh" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_popup_sync" app:tint="#E5E5E5"
            android:contentDescription="@string/refresh" android:tooltipText="@string/refresh" />
        <ImageButton android:id="@+id/bluetooth_audio" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/stat_sys_data_bluetooth" app:tint="#E5E5E5"
            android:contentDescription="@string/bluetooth_audio" android:tooltipText="@string/bluetooth_audio" />
        <ImageButton android:id="@+id/settings" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_preferences" app:tint="#E5E5E5"
            android:contentDescription="@string/settings" android:tooltipText="@string/settings" />
        <ImageButton android:id="@+id/sign_out" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_lock_power_off" app:tint="#E5E5E5" android:visibility="gone"
            android:contentDescription="@string/logout" android:tooltipText="@string/logout" />
    </LinearLayout>
    <RadioGroup android:id="@+id/tabs" android:layout_width="match_parent" android:layout_height="48dp"
        android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp"
        android:checkedButton="@id/tab_albums">
        <RadioButton android:id="@+id/tab_albums" style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:button="@null" android:gravity="center" android:text="@string/albums"
            android:textColor="@color/tab_text" android:background="@drawable/tab_background" />
        <RadioButton android:id="@+id/tab_folders" style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:button="@null" android:gravity="center" android:text="@string/songs"
            android:textColor="@color/tab_text" android:background="@drawable/tab_background" />
        <RadioButton android:id="@+id/tab_queue" style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:button="@null" android:gravity="center" android:text="@string/queue"
            android:textColor="@color/tab_text" android:background="@drawable/tab_background"
            android:visibility="gone" />
        <RadioButton android:id="@+id/tab_downloads" style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:button="@null" android:gravity="center" android:text="@string/downloads"
            android:textSize="12sp" android:paddingHorizontal="0dp" android:minWidth="0dp"
            android:textColor="@color/tab_text" android:background="@drawable/tab_background" />
    </RadioGroup>
    <EditText android:id="@+id/search" android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginHorizontal="16dp" android:hint="@string/search" android:singleLine="true"
        android:inputType="text" android:imeOptions="actionSearch" android:autofillHints=""
        android:textSize="16sp" android:paddingHorizontal="8dp" />
    <ProgressBar android:id="@+id/loading" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="3dp" android:indeterminate="true"
        android:visibility="invisible" />
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="16dp" android:textSize="14sp" android:visibility="gone"
        android:accessibilityLiveRegion="polite" />
    <ListView android:id="@+id/library" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:divider="#282828" android:dividerHeight="1dp"
        android:clipToPadding="false" android:paddingHorizontal="8dp" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#303030" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
        android:orientation="horizontal" android:background="#181818"
        android:paddingHorizontal="16dp" android:paddingVertical="8dp" android:gravity="center_vertical">
        <ImageView android:id="@+id/current_art" android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_azify" android:scaleType="centerCrop" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="12dp" android:orientation="vertical" android:gravity="center_vertical">
            <TextView android:id="@+id/current_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/nothing_playing" android:maxLines="1" android:ellipsize="end"
                android:textStyle="bold" android:textSize="14sp" />
            <TextView android:id="@+id/current_album" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end" android:textColor="#ABABAB" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
    <androidx.media3.ui.PlayerControlView android:id="@+id/controls"
        android:layout_width="match_parent" android:layout_height="96dp"
        android:background="#181818" app:show_timeout="0" app:show_shuffle_button="true"
        app:controller_layout_id="@layout/player_controls"
        app:repeat_toggle_modes="one|all" app:animation_enabled="false" />
</LinearLayout>
